# macOS
.DS_Store
._*

# Script output
# doctor.sh and snapshot.sh write to /tmp by default; this is only a fallback
*.pyc
__pycache__/
.venv/
*.tmp
splitjam-snapshots/

# Editors
.vscode/
.idea/
*.swp
*~

# references/commands.md is intentionally NOT ignored:
# it is generated by scripts/gen-commands.sh, but a freshly cloned skill must be readable
# without running anything (symlink or copy), so the generated result ships with the repo.
