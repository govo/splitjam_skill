# macOS
.DS_Store
._*

# Script output
# doctor.sh and snapshot.sh write to /tmp by default; this is only a fallback
*.pyc
__pycache__/
.venv/
*.tmp
splitjam-snapshots/

# Editors
.vscode/
.idea/
*.swp
*~

# references/tools.md is intentionally NOT ignored:
# it mirrors tools/list and is regenerated by scripts/gen-tools.sh, but a freshly cloned
# skill must be readable without a running app, so the generated result ships with the repo.
